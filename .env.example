# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# Every setting is validated at startup; run `npm run check` to test your keys.
# Use another file with ENV_FILE=/path/to/file. Real environment variables (Docker, systemd) override this file.

# ── Which AI answers chat ───────────────────────────────────────────
# gemini = Google Gemini (needs GEMINI_API_KEY below), groq = the LLM_* settings. The other one is used as automatic backup.
MAIN_AI=groq

# ── LLM: any OpenAI-compatible endpoint ─────────────────────────────
# Groq (default): free tier, very fast, no card. Key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Used automatically if the main model is rate-limited (429) or unavailable
LLM_FALLBACK_MODEL=qwen/qwen3.6-27b
# For gpt-oss models: low = faster + uses less of the free quota. Leave empty for other models.
LLM_REASONING_EFFORT=low
# How many tool rounds the AI may use per question
LLM_MAX_TOOL_STEPS=5

# Google Gemini (free tier). Key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-flash-latest
# LLM_FALLBACK_MODEL=
# LLM_REASONING_EFFORT=

# OpenRouter (pick any model whose id ends in ":free"). Key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<model-id>:free

# Ollama: 100% local and private, no key, needs a decent GPU/CPU. `ollama pull qwen3:8b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# ── Google Gemini (main AI when MAIN_AI=gemini, and YouTube summaries) ──
# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google to improve its products, so don't send sensitive info.
GEMINI_API_KEY=
# Leave empty to route automatically; set a model id to always try it first (e.g. gemini-3.8-flash)
GEMINI_MODEL=
# Models never to use, comma separated; a trailing * matches a prefix (e.g. gemini-3.8-flash,gemini-2.0-*).
# `npm run check -- --probe` times every model and prints this line for the slow ones.
# (Models that time out are also removed automatically for 24 hours; that is remembered in AUTH_DIR.)
GEMINI_EXCLUDE_MODELS=
# true = free AI Studio key: the bot counts requests per model and skips a model whose free daily/per-minute
# quota is used up (limits are in src/config/constants.ts, GEMINI.freeTierLimits). false = paid key, no limits.
GEMINI_FREE_TIER=true
# Model routing: every question is rated 1-10 first, then sent to the lightest model that fits
# (1-5 Flash-Lite, 6-7 Flash, 8-9 Flash + more thinking, 10 Pro if your key has it), climbing if the answer is weak.
# ai = rate with one quick call to the fastest model (falls back to heuristic); heuristic = instant, no extra AI call
ROUTER_RATING=ai
# auto = each routing level sets the thinking; or force low/high for every answer; default = Google's default
GEMINI_THINKING_LEVEL=auto
# Video frames per second Gemini looks at (lower = cheaper on the free quota; audio is always used)
YOUTUBE_FPS=0.5

# ── WhatsApp ─────────────────────────────────────────────────────────
# Word that wakes the bot. Real @mentions of the bot's number also work.
BOT_TRIGGER=@bot
# Who may use it (besides you, when it runs on your own number).
# Phone numbers with country code, comma separated, e.g. 972501234567,972541112222
ALLOWED_USERS=
# Group ids where everyone may use it. Get one with "@bot /chatid" inside the group.
ALLOWED_GROUPS=
# true = anyone who can message the account can use it (and spend your quota)
ALLOW_EVERYONE=false
# In private chats with the bot, answer every message without needing @bot.
# Only turn this on when the bot has its OWN number (otherwise it would answer your personal chats).
DM_WITHOUT_TRIGGER=false
# Reply when YOU write @bot from the linked account (needed if the bot runs on your own number)
RESPOND_TO_SELF=true
# Link with an 8-character code instead of a QR (handy on servers/Docker). Digits with country code.
PAIRING_NUMBER=
AUTH_DIR=./auth
# Optional: Alpaca market data keys (alpaca.markets, free paper account is enough). When Yahoo can't be
# reached, "@bot summary" uses Alpaca's live prices (free plan: IEX exchange, 200 calls/minute) with ETFs
# standing in for the indexes (QQQ, SPY, DIA). ALPACA_FEED=sip only with a paid data plan.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
# Optional: free Massive (massive.com, formerly Polygon.io) key. When Yahoo can't be reached, "@bot summary"
# shows the last close from Massive instead (free plan: end-of-day data, 5 calls/minute).
MASSIVE_API_KEY=
# Chromium/Chrome that draws the "@bot summary" pictures. Empty = find it automatically
# (/usr/bin/chromium, google-chrome...); "off" = always use the built-in SVG version.
CHROMIUM_PATH=

# ── Behaviour ────────────────────────────────────────────────────────
# Language for every answer: auto (= the language the user writes in), en, he, ar, or any language name
REPLY_LANGUAGE=auto
# Optional: extra personality/rules for plain-language answers, e.g.
# BOT_INSTRUCTIONS="Be friendly and use a little humour. Prefer short answers. Focus on Israeli and US stocks."
BOT_INSTRUCTIONS=
# Language for /summary when none is given: en, he or ar ("/summary he" overrides it)
DEFAULT_LANGUAGE=en
REPLY_PREFIX="🤖 "
RATE_LIMIT_PER_MINUTE=6
HISTORY_TURNS=6
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=info
